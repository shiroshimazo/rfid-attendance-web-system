# Copy this file to .env and fill in values from your Supabase project settings.

# Public values used by the browser Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secrets; never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server/device shared secret for POST /api/rfid/tap (at least 32 random characters).
# Generate locally; do not use the Supabase key here or expose this in browser code.
RFID_DEVICE_API_KEY=

# P06: enable only after the migration, account credit and sender ID are ready.
PHILSMS_ENABLED=false
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=
PHILSMS_API_URL=https://app.philsms.com/api/v3/sms/send

# PostgreSQL connection strings. Percent-encode special characters in passwords.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
